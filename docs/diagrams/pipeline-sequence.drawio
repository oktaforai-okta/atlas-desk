<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Pipeline Sequence" id="pipeseq1">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Ticket lifecycle &#183; a shared prefix, then two paths that never reconverge" style="text;html=1;align=left;verticalAlign=middle;fontColor=#00033E;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="34" as="geometry" />
        </mxCell>

        <!-- Shared prefix: steps 1-4, both paths -->
        <mxCell id="inbound" value="1 &#183; inbound&#xa;Intake API&#xa;no Okta involvement yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFA;strokeColor=#E0DAD2;fontColor=#00033E;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="readgrant" value="2 &#183; read_grant&#xa;Agent 1 (Atlas Triage Agent)&#xa;granted ticket.read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00033E;strokeColor=#00033E;fontColor=#FFFFFF;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="90" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="jiraread" value="3 &#183; jira_read&#xa;GET /rest/api/3/search&#xa;checks for duplicates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFA;strokeColor=#E0DAD2;fontColor=#00033E;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="90" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="classify" value="4 &#183; classify&#xa;Claude classifies + judges&#xa;self-serviceable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFA;strokeColor=#E0DAD2;fontColor=#00033E;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="90" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#8C8C8C;strokeWidth=1.4;" edge="1" parent="1" source="inbound" target="readgrant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0131FF;strokeWidth=1.6;" edge="1" parent="1" source="readgrant" target="jiraread">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0131FF;strokeWidth=1.6;" edge="1" parent="1" source="jiraread" target="classify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="branchlabel" value="both paths share the four steps above &#183; from here, the run either delegates or over-reaches, never both" style="text;html=1;align=left;verticalAlign=middle;fontColor=#5A5A5A;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="120" width="620" height="40" as="geometry" />
        </mxCell>

        <!-- NORMAL PATH lane -->
        <mxCell id="normallane" value="NORMAL PATH &#183; Agent 1 delegates instead of over-reaching" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECE8E4;strokeColor=#0131FF;fontColor=#00033E;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=14;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="1660" height="180" as="geometry" />
        </mxCell>
        <mxCell id="agent2" value="5-6 &#183; a2a_delegate &#8594; write_grant&#xa;Agent 2 (Atlas Resolution Agent)&#xa;granted ticket.write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00033E;strokeColor=#00033E;fontColor=#FFFFFF;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="normallane">
          <mxGeometry x="40" y="45" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="draft" value="7 &#183; draft&#xa;Claude drafts the&#xa;resolution text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFA;strokeColor=#E0DAD2;fontColor=#00033E;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="normallane">
          <mxGeometry x="360" y="45" width="200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="vault" value="8 &#183; opa_vault&#xa;OPA releases the Jira credential&#xa;subject = Agent 2's own inbound token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0131FF;strokeColor=#0131FF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="normallane">
          <mxGeometry x="650" y="45" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="jirawrite" value="Jira Cloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFA;strokeColor=#E0DAD2;fontColor=#00033E;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="normallane">
          <mxGeometry x="990" y="45" width="170" height="95" as="geometry" />
        </mxCell>
        <mxCell id="done" value="done&#xa;auto-resolved or routed,&#xa;customer notified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12805A;strokeColor=#12805A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="normallane">
          <mxGeometry x="1250" y="45" width="220" height="95" as="geometry" />
        </mxCell>

        <mxCell id="edelegate" value="5 &#183; a2a_delegate &#183; id-jag, act: Triage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#0131FF;strokeWidth=1.8;fontColor=#0131FF;fontStyle=1;fontSize=11;" edge="1" parent="1" source="classify" target="agent2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="en1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0131FF;strokeWidth=1.6;" edge="1" parent="normallane" source="agent2" target="draft">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="en2" value="8 &#183; opa_vault" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0131FF;strokeWidth=1.6;fontColor=#0131FF;fontSize=11;" edge="1" parent="normallane" source="draft" target="vault">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="en3" value="9 &#183; jira_write &#183; ticket.write &#183; real POST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#12805A;strokeWidth=1.6;fontColor=#12805A;fontStyle=1;fontSize=11;" edge="1" parent="normallane" source="vault" target="jirawrite">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="en4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#12805A;strokeWidth=1.6;" edge="1" parent="normallane" source="jirawrite" target="done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- VIOLATION PATH lane -->
        <mxCell id="violationlane" value="VIOLATION PATH &#183; Agent 1 over-reaches, Okta refuses" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECE8E4;strokeColor=#C72D36;fontColor=#00033E;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=14;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="770" height="200" as="geometry" />
        </mxCell>
        <mxCell id="denied" value="5 &#183; write_denied&#xa;&#10007; Agent 1 asks Okta for ticket.write&#xa;400 invalid_scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFA;strokeColor=#C72D36;strokeWidth=1.6;fontColor=#C72D36;fontSize=12;fontStyle=1;arcSize=12;dashed=1;" vertex="1" parent="violationlane">
          <mxGeometry x="40" y="45" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="deniederr" value="&quot;The following scopes are not allowed for this&#xa;request: [ticket.write].&quot;" style="text;html=1;align=left;verticalAlign=top;fontColor=#7A2028;fontSize=11;fontStyle=2;spacingLeft=4;" vertex="1" parent="violationlane">
          <mxGeometry x="40" y="130" width="290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="blocked" value="6 &#183; blocked&#xa;nothing written to Jira&#xa;Agent 2, the vault, and Jira stay dark" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C72D36;strokeColor=#C72D36;fontColor=#FFFFFF;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="violationlane">
          <mxGeometry x="420" y="45" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="eviolate" value="Agent 1 attempts a write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#C72D36;strokeWidth=1.6;fontColor=#C72D36;fontStyle=1;fontSize=11;" edge="1" parent="1" source="classify" target="denied">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ev1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#C72D36;strokeWidth=1.6;dashed=1;" edge="1" parent="violationlane" source="denied" target="blocked">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="Both paths are selected by the same caller (GET /api/run?mode=normal|violation) and share steps 1-4 exactly. The refusal is only ever shown when it actually prevented something." style="text;html=1;align=left;verticalAlign=middle;fontColor=#5A5A5A;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="1200" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
