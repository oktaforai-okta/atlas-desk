<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Without vs With Okta" id="wvw1">
    <mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="One shared credential vs. governed workload identities" style="text;html=1;align=left;verticalAlign=middle;fontColor=#00033E;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="800" height="34" as="geometry" />
        </mxCell>

        <!-- LEFT: without Okta -->
        <mxCell id="leftlane" value="WITHOUT OKTA &#183; one shared credential" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECE8E4;strokeColor=#C72D36;fontColor=#00033E;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=14;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="670" height="820" as="geometry" />
        </mxCell>
        <mxCell id="agentA" value="Agent A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFA;strokeColor=#E0DAD2;fontColor=#00033E;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="leftlane">
          <mxGeometry x="40" y="50" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="agentB" value="Agent B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFA;strokeColor=#E0DAD2;fontColor=#00033E;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="leftlane">
          <mxGeometry x="40" y="160" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sharedkey" value="Shared API key&#xa;(one secret, every caller)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C72D36;strokeColor=#C72D36;fontColor=#FFFFFF;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="leftlane">
          <mxGeometry x="300" y="105" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="downstreamL" value="Downstream&#xa;system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFA;strokeColor=#E0DAD2;fontColor=#00033E;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="leftlane">
          <mxGeometry x="560" y="105" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="eA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#C72D36;strokeWidth=1.6;" edge="1" parent="leftlane" source="agentA" target="sharedkey"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#C72D36;strokeWidth=1.6;" edge="1" parent="leftlane" source="agentB" target="sharedkey"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eKD" value="every call, same secret" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#C72D36;strokeWidth=1.6;fontColor=#C72D36;fontStyle=1;fontSize=11;" edge="1" parent="leftlane" source="sharedkey" target="downstreamL"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="lcallouts" value="&#8226; Every caller looks the same in the log.&#xa;&#xa;&#8226; Whoever holds the key can read AND write &#8212; capability is whatever the key happens to grant, not a decision anyone made.&#xa;&#xa;&#8226; Revoke it and every agent using it breaks at once, so in practice nobody revokes it.&#xa;&#xa;&#8226; The only record of who did what is whatever this application chose to log, which means anyone who can change the application can change the record." style="text;html=1;align=left;verticalAlign=top;fontColor=#7A2028;fontSize=13;spacingLeft=4;" vertex="1" parent="leftlane">
          <mxGeometry x="40" y="280" width="600" height="480" as="geometry" />
        </mxCell>

        <!-- RIGHT: with Okta -->
        <mxCell id="rightlane" value="WITH OKTA &#183; this repo, verified live" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECE8E4;strokeColor=#0131FF;fontColor=#00033E;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=14;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="740" y="60" width="720" height="820" as="geometry" />
        </mxCell>
        <mxCell id="triage" value="Triage Agent&#xa;ticket.read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00033E;strokeColor=#00033E;fontColor=#FFFFFF;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="rightlane">
          <mxGeometry x="40" y="40" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="denied" value="&#10007; ticket.write&#xa;400 invalid_scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFA;strokeColor=#C72D36;strokeWidth=1.6;fontColor=#C72D36;fontSize=12;fontStyle=1;arcSize=12;dashed=1;" vertex="1" parent="rightlane">
          <mxGeometry x="40" y="150" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eDenied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#C72D36;strokeWidth=1.6;dashed=1;endArrow=none;" edge="1" parent="rightlane" source="triage" target="denied"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="xmark" value="&#10005;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#C72D36;fontSize=20;fontStyle=1;" vertex="1" parent="rightlane">
          <mxGeometry x="112" y="113" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="resolution" value="Resolution Agent&#xa;ticket.write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00033E;strokeColor=#00033E;fontColor=#FFFFFF;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="rightlane">
          <mxGeometry x="330" y="40" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="eDelegate" value="id-jag &#183; act: Triage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0131FF;strokeWidth=1.8;fontColor=#0131FF;fontStyle=1;fontSize=11;" edge="1" parent="rightlane" source="triage" target="resolution"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="shieldjag" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#0131FF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.shield2;" vertex="1" parent="rightlane">
          <mxGeometry x="255" y="55" width="34" height="34" as="geometry" />
        </mxCell>

        <mxCell id="vault" value="OPA Vault&#xa;subject = own inbound token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0131FF;strokeColor=#0131FF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="rightlane">
          <mxGeometry x="330" y="150" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="eVault" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#0131FF;strokeWidth=1.6;" edge="1" parent="rightlane" source="resolution" target="vault"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="jira" value="Jira&#xa;real POST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFA;strokeColor=#E0DAD2;fontColor=#00033E;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="rightlane">
          <mxGeometry x="580" y="40" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="eJira" value="ticket.write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#12805A;strokeWidth=1.6;fontColor=#12805A;fontStyle=1;fontSize=11;" edge="1" parent="rightlane" source="resolution" target="jira"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="rcallouts" value="&#8226; Two identities, two scopes. Neither can hold the other's, and Okta will not quietly issue a smaller grant instead.&#xa;&#xa;&#8226; The refusal happens before a token exists, not after a check inside this application.&#xa;&#xa;&#8226; Revoking Triage breaks only Triage's hand-off; Resolution keeps working.&#xa;&#xa;&#8226; Every hop above is a signed act claim plus a real Okta System Log event id, independently verifiable, not self-reported." style="text;html=1;align=left;verticalAlign=top;fontColor=#00033E;fontSize=13;spacingLeft=4;" vertex="1" parent="rightlane">
          <mxGeometry x="40" y="280" width="640" height="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
